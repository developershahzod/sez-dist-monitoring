<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Short cache: a git pull of a new build reaches browsers within minutes -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:05:00" />
      <!-- Types IIS does not serve by default; the platform in app/ needs them (BIM models, map data, fonts) -->
      <remove fileExtension=".glb" />
      <mimeMap fileExtension=".glb" mimeType="model/gltf-binary" />
      <remove fileExtension=".geojson" />
      <mimeMap fileExtension=".geojson" mimeType="application/geo+json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <!-- The folder is a git clone: never serve its .git -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment=".git" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
