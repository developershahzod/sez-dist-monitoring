<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Short cache: a git pull of a new build reaches browsers within minutes -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:05:00" />
    </staticContent>
    <!-- The folder is a git clone: never serve its .git -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment=".git" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
